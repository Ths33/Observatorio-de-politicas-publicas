---
import {content,type Lang} from '../content/site';
const {lang}:{lang:Lang}=Astro.props;const t=content[lang];const other=lang==='en'?'pt':'en';const prefix='/'+lang+'/';
---
<div class="site-shell" data-portfolio>
<header class="site-header"><a class="signature" href={prefix} aria-label="Tales Henrique">tales<span>.</span></a><span class="header-caption">{t.eyebrow}</span><nav aria-label="Primary">{t.nav.map((name,i)=><a href={'#'+['approach','work','intelligence','contact'][i]}>{name}</a>)}</nav><a class="language" href={'/'+other+'/'} hreflang={other}>{other.toUpperCase()} ↗</a></header>
<main>
<section class="hero" aria-labelledby="hero-title"><div class="hero-index">01 / 04 — CREATIVE ENGINEERING</div><div class="hero-body"><p class="hero-kicker">TALES HENRIQUE — FULL-STACK / AI</p><h1 id="hero-title"><span>{t.hero[0]}</span><span class="serif">{t.hero[1]}</span></h1><p class="hero-intro">{t.intro}</p></div><div class="hero-art" aria-hidden="true"><div class="art-orbit"><div class="art-plane"></div><div class="art-core"></div></div><span class="art-label">FORM / FUNCTION / FEELING</span></div><div class="hero-bottom"><span>{t.lead}</span><a href="#approach">{t.explore} <span aria-hidden="true">↘</span></a></div></section>
<section id="approach" class="approach section-frame" aria-labelledby="approach-title"><div class="section-label">01 — PRACTICE</div><div class="section-heading"><h2 id="approach-title">{t.approach}</h2><p>{t.approachText}</p></div><div class="practice-layout"><div class="practice-canvas" data-practice aria-label="Interactive system diagram"><svg viewBox="0 0 600 480" role="img" aria-label="Three connected disciplines: interface, infrastructure, intelligence"><path class="connection" d="M300 70 L110 355 L490 355 Z"/><circle data-node-circle="0" cx="300" cy="70" r="42"/><circle data-node-circle="1" cx="110" cy="355" r="42"/><circle data-node-circle="2" cx="490" cy="355" r="42"/><circle cx="300" cy="255" r="10" class="diagram-center"/></svg><span class="diagram-caption">A SYSTEM IS MORE THAN ITS PARTS.</span></div><div class="practice-list">{t.nodes.map(([name,description],i)=><button type="button" class:list={['practice-item',{'selected':i===0}]} data-practice-select={i} aria-pressed={i===0?'true':'false'}><span class="practice-num">0{i+1}</span><span><strong>{name}</strong><small>{description}</small></span><span class="practice-arrow">↗</span></button>)}</div></div></section>
<section id="work" class="work section-frame" aria-labelledby="work-title"><div class="section-label">02 — WORK</div><div class="section-heading"><h2 id="work-title">{t.work}</h2><p>{t.workIntro}</p></div><div class="work-grid">{t.cases.map(([title,company,description,slug],i)=><a class="work-card" href={prefix+'work/'+slug+'/'}><div class:list={['case-visual','visual-'+slug]} aria-hidden="true"><span class="visual-index">0{i+1} / ENGINEERING</span><div class="visual-form"><span></span><span></span><span></span></div></div><div class="case-meta"><span>{company}</span><span>0{i+1} ↗</span></div><h3>{title}</h3><p>{description}</p><span class="case-link">{t.viewCase} ↗</span></a>)}</div></section>
<section id="intelligence" class="intelligence section-frame" aria-labelledby="intelligence-title"><div class="section-label">03 — INTELLIGENCE</div><div class="section-heading"><h2 id="intelligence-title">{t.intelligence}</h2><p>{t.intelligenceText}</p></div><div class="system-demo" data-demo><div class="system-track">{['REQUEST','LLM','MCP TOOL','BUSINESS DATA','RESPONSE'].map((label,i)=><div class="system-step" data-step={i}><span>0{i+1}</span><strong>{label}</strong></div>)}</div><div class="system-actions"><button type="button" data-run>{t.run} ↗</button><button type="button" data-reset>{t.reset} ↺</button><output data-status aria-live="polite">READY / CONCEPTUAL DEMO</output></div></div><p class="system-context">BLUECROCUS / MCP INTEGRATIONS / AI-POWERED OPERATIONS</p></section>
<section id="contact" class="closing section-frame"><div class="section-label">04 — COLLABORATE</div><h2>{t.contact}</h2><p>{t.contactText}</p><a class="big-contact" href="mailto:tales.33.henriques@gmail.com">{t.cta}<span>↗</span></a><div class="closing-bottom"><span>TALES HENRIQUE © {new Date().getFullYear()}</span><a href="https://www.linkedin.com/in/taleshenriquesilva" rel="me">LINKEDIN ↗</a><span>{t.footer}</span></div></section>
</main></div>
<script>import '../lib/portfolio';</script>