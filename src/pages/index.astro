---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Tales Henrique — Em construção" description="Um novo site está a caminho.">
  <main>
    <span class="eyebrow">TALES HENRIQUE</span>
    <h1>Em construção<span>.</span></h1>
    <p>Um novo site está chegando.</p>
  </main>
</BaseLayout>
<style>
  :global(*){box-sizing:border-box}
  :global(html){font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#101414;color:#f4f4ef}
  :global(body){margin:0}
  main{min-height:100svh;display:flex;flex-direction:column;justify-content:center;padding:clamp(24px,8vw,120px)}
  .eyebrow{font-size:12px;font-weight:750;letter-spacing:.2em;color:#9caaa6}
  h1{font-size:clamp(48px,10vw,130px);line-height:1;letter-spacing:-.08em;margin:25px 0}
  h1 span{color:#b5f1a1}
  p{font-size:clamp(16px,2vw,22px);color:#a7b2ae}
</style>
