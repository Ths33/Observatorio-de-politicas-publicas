---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/experience.css';
import {chapters} from '../content/chapters';
---
<BaseLayout title="Tales Henrique — Creative Engineering & AI" description="Tales Henrique: senior full-stack engineer and AI application engineer. Technical partnerships for international agencies.">
<main id="experience" aria-label="Immersive portfolio">
<header class="masthead"><a class="monogram" href="/" aria-label="Tales Henrique home">TH<span>.</span></a><span class="masthead-center">INDEPENDENT ENGINEER — SÃO PAULO / WORLDWIDE</span><a class="contact" href="mailto:tales.33.henriques@gmail.com">START A CONVERSATION ↗</a></header>
<div class="viewport" id="viewport"><canvas id="matter" aria-hidden="true"></canvas>
{chapters.map((chapter,index)=><section class:list={['scene',{'is-active':index===0}]} data-scene={index} data-variant={chapter.variant} inert={index!==0} aria-label={chapter.name}>
  <div class="chapter-meta"><span>{String(index+1).padStart(2,'0')} / {String(chapters.length).padStart(2,'0')}</span><span>{chapter.eyebrow}</span></div>
  <div class="scene-copy">
    <p class="scene-overline">{chapter.overline}</p>
    <h1 class="scene-title">{chapter.title.map((line,i)=><span class:list={['title-line',{'accent':i===chapter.accentLine}]}>{line}</span>)}</h1>
    <p class="scene-description">{chapter.description}</p>
    {chapter.points && <ul class="scene-points">{chapter.points.map(point=><li>{point}</li>)}</ul>}
    {chapter.cta && <a class="scene-cta" href={chapter.cta.href}>{chapter.cta.label} <span aria-hidden="true">↗</span></a>}
    {chapter.interactive && <div class="system-controls"><button id="activate" type="button">RUN SYSTEM DEMO ↗</button><output id="system-output" aria-live="polite">INPUT → MODEL → TOOL → RESPONSE</output></div>}
  </div>
  <p class="scene-footer">{chapter.footer}</p>
</section>)}
</div>
<nav class="chapter-nav" aria-label="Chapter navigation">{chapters.map((chapter,i)=><button type="button" data-go={i} aria-current={i===0?'step':undefined}><span class="nav-number">{String(i+1).padStart(2,'0')}</span><span class="nav-name">{chapter.name}</span></button>)}</nav>
<div class="scene-controls"><button id="previous" type="button" aria-label="Previous scene">↑</button><span id="progress" aria-live="polite">01 / {String(chapters.length).padStart(2,'0')}</span><button id="following" type="button" aria-label="Next scene">↓</button></div>
<a class="reading-toggle" href="#reading">READING MODE ↗</a>
</main>
<section class="reading" id="reading" aria-label="Linear accessible portfolio">
<header><p>TALES HENRIQUE / CREATIVE ENGINEERING</p><a href="#experience">RETURN TO EXPERIENCE ↑</a></header>
{chapters.map(chapter=><article><p class="reading-kicker">{chapter.eyebrow}</p><h2>{chapter.title.join(' ')}</h2><p>{chapter.description}</p>{chapter.points&&<ul>{chapter.points.map(point=><li>{point}</li>)}</ul>}{chapter.cta&&<p><a href={chapter.cta.href}>{chapter.cta.label} ↗</a></p>}</article>)}
<footer><a href="https://www.linkedin.com/in/taleshenriquesilva" rel="me">LINKEDIN ↗</a> <a href="mailto:tales.33.henriques@gmail.com">EMAIL ↗</a></footer>
</section>
<script>import {bootExperience} from '../lib/experience';bootExperience();</script>
</BaseLayout>